# Secrets referenced from accounts.json as "env:VAR_NAME".
# Copy to .env and fill in, or export these however you normally manage secrets.
# One variable per account is what makes several accounts per platform work.

# --- Instagram (Business/Creator, long-lived tokens) ---
IG_MAIN_TOKEN=
IG_ALT_TOKEN=

# --- YouTube (OAuth refresh token per channel) ---
YT_MAIN_REFRESH=
YT_ALT_REFRESH=
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# --- TikTok (refresh token rotates on use; the server rewrites it) ---
TT_MAIN_REFRESH=
TT_ALT_REFRESH=
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# --- X / Twitter (OAuth 2.0 with offline.access) ---
X_MAIN_REFRESH=
X_ALT_REFRESH=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- LinkedIn ---
LI_TOKEN=

# --- Server options ---
# SOCIAL_MCP_CONFIG=/custom/path/accounts.json
# SOCIAL_MCP_DEBUG=1
# LINKEDIN_VERSION=202506
# IG_API_VERSION=v23.0
