{
  "version": 1,
  "accounts": [
    {
      "id": "ig_main",
      "platform": "instagram",
      "label": "Main brand Instagram",
      "handle": "@brand",
      "tags": ["brand", "en"],
      "credentials": {
        "igUserId": "17841400000000001",
        "accessToken": "env:IG_MAIN_TOKEN"
      }
    },
    {
      "id": "ig_alt",
      "platform": "instagram",
